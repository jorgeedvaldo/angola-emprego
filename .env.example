# Porta onde o serviço fica à escuta.
PORT=3000

# Chave secreta que o Laravel (angolaemprego.com) tem de enviar no cabeçalho
# "X-API-Key" em todos os pedidos. Gere uma string longa e aleatória, ex:
#   openssl rand -hex 32
# Deixe vazio APENAS em desenvolvimento local.
API_KEY=

# Domínios com permissão para chamar este serviço directamente do browser
# (separados por vírgula). Se só o backend Laravel chamar este serviço
# (servidor-a-servidor), pode deixar vazio.
ALLOWED_ORIGINS=https://angolaemprego.com

# Modelo de embeddings (multilingue, cobre português). Não mude sem também
# mudar VectorSimilarity::MODEL_ID no lado do Laravel — vectores de modelos
# diferentes não são comparáveis entre si.
MODEL_ID=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Onde o modelo fica guardado em disco depois de descarregado a primeira vez.
MODEL_CACHE_DIR=./model-cache

# Idioma usado no OCR de CVs digitalizados (imagem).
OCR_LANGUAGE=por

# Limites de segurança/desempenho.
MAX_TEXT_LENGTH=8000
MIN_TEXT_LENGTH_BEFORE_OCR=40
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=15
